# Public domain served by Caddy (auto-HTTPS via Let's Encrypt) and coturn realm
DOMAIN=velodeck.example.com

# Public IPv4 of the VPS for coturn (required when behind cloud NAT such as AWS/GCP/Alibaba)
PUBLIC_IP=

# Server bind address and port
HOST=0.0.0.0
PORT=8080

# Trust X-Real-IP / X-Forwarded-For ONLY when running behind a trusted reverse proxy (e.g. Caddy)
# Keep false for direct pure-IP deployments (docker-compose.ip.yml)
TRUST_PROXY=false

# Account registration policy: first-user-then-invite | invite | open | closed
REGISTRATION_MODE=first-user-then-invite

# Required when REGISTRATION_MODE=invite, or for 2nd+ users in first-user-then-invite mode
REGISTRATION_INVITE_CODE=

# Disable deprecated shared accessToken auth by default (set true ONLY for legacy clients)
ENABLE_LEGACY_TOKEN_AUTH=false

# Comma-separated extra allowed browser origins for CORS & WS upgrades (same-origin + Capacitor allowed automatically)
ALLOWED_ORIGINS=

# Optional secret token for remote access to GET /api/admin/stats (via X-Admin-Token header)
ADMIN_TOKEN=

# Optional quotas & WebSocket limits
MAX_USERS=100
MAX_DEVICES=100
MAX_WS_CONNECTIONS=500
MAX_WS_PER_IP=15

# Set true to require a valid Bearer JWT to download the Android APK
REQUIRE_AUTH_FOR_APK=false

# WebSocket heartbeat cadence and dead-connection timeout (milliseconds)
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_TIMEOUT_MS=35000

# Comma-separated STUN server URLs (Mainland-China-reachable defaults)
STUN_URLS=stun:stun.miwifi.com:3478,stun:stun.chat.bilibili.com:3478

# Comma-separated TURN server URLs (optional; recommended for strict cellular/corporate NAT)
TURN_URLS=turn:velodeck.example.com:3478?transport=udp,turn:velodeck.example.com:3478?transport=tcp

# Shared secret for coturn use-auth-secret ephemeral HMAC-SHA1 credentials (REQUIRED for TURN)
# MUST be replaced with a random secret generated via: openssl rand -hex 32
TURN_SECRET=

# Optional static TURN fallback credentials (used only if TURN_SECRET is unset)
TURN_USERNAME=
TURN_PASSWORD=

# Ephemeral TURN credential lifetime in seconds (default 1800 = 30 minutes)
TURN_TTL_SECONDS=1800

# Persistent data directory for accounts, bound devices, audit logs, and auto-generated jwt.secret
DATA_DIR=./data

# Optional fixed HMAC-SHA256 secret for JWT signing (if omitted, persisted in DATA_DIR/jwt.secret with 0600)
JWT_SECRET=

# Path to downloadable Android agent APK served by GET /api/download/velodeck-agent.apk
APK_PATH=./downloads/velodeck-agent.apk

# Optional override for static web controller assets (defaults to ../controller/dist)
STATIC_DIR=

# Max failed WebSocket/HTTP auth attempts per client IP per minute
MAX_FAILED_AUTH_PER_MIN=30
