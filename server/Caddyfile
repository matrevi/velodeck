{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	reverse_proxy velodeck-server:8080 {
		# Preserve authenticated client IP for TRUST_PROXY=true
		header_up X-Real-IP {remote_host}
		# Keep WebSocket connections alive smoothly behind Caddy
		flush_interval -1
	}
}
