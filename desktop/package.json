{
  "name": "@velodeck/desktop",
  "version": "1.0.9",
  "private": true,
  "description": "VeloDeck (极控) Desktop Controller — low-latency 60fps Android remote control for macOS & Windows",
  "main": "dist/main.js",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "prepare:web": "node scripts/prepare-build.mjs",
    "compile": "tsc -p tsconfig.json",
    "build": "pnpm run prepare:web && pnpm run compile",
    "dev": "pnpm run compile && VELODECK_DESKTOP_DEV_URL=http://localhost:5173 electron .",
    "start": "pnpm run build && electron .",
    "test": "node --test src/desktop.test.ts",
    "pack:mac": "pnpm run build && electron-builder --mac --dir",
    "dist:mac": "pnpm run build && electron-builder --mac dmg",
    "dist:win": "pnpm run build && electron-builder --win nsis portable",
    "dist:linux": "pnpm run build && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.2"
  }
}
