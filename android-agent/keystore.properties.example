# Copy this file to `android-agent/keystore.properties` (automatically gitignored).
# Never commit your real keystore (.jks) or passwords to Git.
#
# Generate a personal release keystore once:
#   keytool -genkeypair -v -keystore velodeck-release.jks -alias velodeck \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=velodeck-release.jks
storePassword=CHANGE_ME_STORE_PASSWORD
keyAlias=velodeck
keyPassword=CHANGE_ME_KEY_PASSWORD
