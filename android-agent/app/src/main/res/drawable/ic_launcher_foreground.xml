        </aapt:attr>
    </path>

    <!-- Solid emerald live status LED core -->
    <path android:pathData="M65.39,50.53 A3.47,3.47 0 1,1 65.38,50.53 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="64.6"
                android:centerY="53.1"
                android:gradientRadius="4.5"
                android:type="radial">
                <item
                    android:color="#FF34D399"
                    android:offset="0.0" />
                <item
                    android:color="#FF10B981"
                    android:offset="0.62" />
                <item
                    android:color="#FF059669"
