        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="5.61" />

    <!-- Inner slanted-top D stem strictly parallel to V's right stroke -->
    <path
        android:fillColor="#F8FAFC"
        android:pathData="M50.04,68.85 L50.04,62.58 L55.65,48.56 L55.65,68.85 Z" />

    <!-- Rounded bottom-left shoulder join of D -->
