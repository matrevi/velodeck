{
  "name": "velodeck-monorepo",
  "version": "1.0.9",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm -r build",
    "build:protocol": "pnpm --filter @velodeck/protocol build",
    "build:server": "pnpm --filter @velodeck/server build",
    "build:controller": "pnpm --filter @velodeck/controller build",
    "test": "pnpm -r test",
    "dev:server": "pnpm --filter @velodeck/server dev",
    "dev:controller": "pnpm --filter @velodeck/controller dev",
    "sync:android-web": "node scripts/sync-controller-to-android.mjs"
  }
}
